{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tamcore/renovate",
    "github>tamcore/renovate:go",
    "github>tamcore/renovate:automerge-minor"
  ],
  "packageRules": [
    {
      "description": "Actions execute in CI with repository credentials. A bumped SHA is a code change and needs a human.",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "description": "Authorization, storage, and crypto dependencies gate the security model. Review every bump by hand.",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/modelcontextprotocol/go-sdk",
        "github.com/ory/fosite",
        "modernc.org/sqlite",
        "filippo.io/**",
        "golang.org/x/crypto",
        "golang.org/x/oauth2",
        "golang.org/x/sys"
      ],
      "automerge": false
    },
    {
      "description": "The runtime base image is pinned by digest, so Renovate is the only thing that keeps it current.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/static-debian12"],
      "groupName": "distroless base image"
    }
  ]
}
